classDiagram
    class User {
        +int id
        +string username
        +string password
        +string email
        +int idrole
    }

    class Child {
        +int id
        +string child_name
        +int sleep_average
        +int treatment_id
        +int time
    }

    class Tap {
        +int id
        +int child_id
        +int status_id
        +int user_id
        +datetime init
        +datetime end
    }

    class Role {
        +int id
        +string type_rol
    }

    class Status {
        +int id
        +string name
    }

    class Treatment {
        +int id
        +string name
    }

    %% Relationships
    User "1" --> "1" Role : has
    Child "1" --> "1" Treatment : uses
    Tap "n" --> "1" User : recorded by
    Tap "n" --> "1" Child : belongs to
    Tap "n" --> "1" Status : has state
    
    %% Many-to-Many via relation_user_child
    User "n" -- "n" Child : linked via relation_user_child